# Supabase browser/server authentication
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Postgres connection string for Drizzle migrations and server queries
DATABASE_URL=

# Development only: bypass Supabase email verification and talent unlock token charges.
# Keep false or remove this variable in staging/production.
NEXT_PUBLIC_DEV_AUTH_BYPASS=false

# Development only: enables POST /api/dev/token-grant for the authenticated recruiter.
# Keep false or remove this variable outside local development.
DEV_TOKEN_GRANT_ENABLED=false

# ─── AI Provider Configuration ───────────────────────────────────────────────
# Set AI_PROVIDER to one of: mock | local | azure (default: azure)
#
#   mock  - Returns hardcoded fallback data. No AI calls made. Good for UI dev.
#   local - Uses a local Ollama / LM Studio / OpenAI-compatible server.
#   azure - Uses Azure OpenAI (requires AZURE_OPENAI_* vars below).
AI_PROVIDER=mock

# Local AI (Ollama, LM Studio, Jan.ai, or any OpenAI-compatible server)
# Used when AI_PROVIDER=local
# Ollama default: http://localhost:11434/v1  |  LM Studio: http://localhost:1234/v1
LOCAL_AI_BASE_URL=http://localhost:11434/v1
# Model name as registered in your local server (e.g. llama3.2, mistral, qwen2.5:7b)
LOCAL_AI_MODEL=llama3.2
# Most local servers don't require a real API key; use any non-empty string
LOCAL_AI_API_KEY=ollama

# Azure OpenAI (used when AI_PROVIDER=azure or AI_PROVIDER is unset)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-11-01-preview
