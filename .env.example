# Supabase browser/server authentication
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
APP_ENV=development

# Supabase Postgres connection string for Drizzle migrations and server queries
DATABASE_URL=

# Development only (never inlined into client bundles): bypass Supabase email
# verification and talent unlock token charges. Server-only; hard-fails in production.
# Keep false or remove this variable outside local development.
DEV_AUTH_BYPASS=false

# Development only: client-side demo affordances (free talent scans, instantly
# active demo registrations). UI-only; has no effect on server authentication.
# Keep false or remove this variable outside local development.
NEXT_PUBLIC_DEMO_MODE=false

# Development only: enables POST /api/dev/token-grant for the authenticated recruiter.
# Keep false or remove this variable outside local development.
DEV_TOKEN_GRANT_ENABLED=false

# Production feature flags. Local defaults keep demo mode usable without providers.
BILLING_ENABLED=true
DOCUMENT_STORAGE_ENABLED=true
EMAIL_DELIVERY_ENABLED=false

# Required to read /api/health/config in production. Do not expose this value to browsers.
HEALTHCHECK_TOKEN=

# Commercial provider configuration
# Development may use mock. Production requires a real provider and webhook secret when billing is enabled.
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=

# Email delivery configuration
# Development uses the server-side mock delivery. Production requires Brevo when email delivery is enabled.
EMAIL_PROVIDER=mock
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
# Supabase Auth SMTP is configured separately in the Supabase dashboard.

# Private CV storage configuration when document storage is enabled
SUPABASE_CV_BUCKET=

# ─── AI Provider Configuration ───────────────────────────────────────────────
# Set AI_PROVIDER to one of: mock | local | azure (default: azure)
#
#   mock  - Returns hardcoded fallback data. No AI calls made. Good for UI dev.
#   local - Uses a local Ollama / LM Studio / OpenAI-compatible server.
#   azure - Uses Azure OpenAI (requires AZURE_OPENAI_* vars below).
AI_PROVIDER=mock

# Local AI (Ollama, LM Studio, Jan.ai, or any OpenAI-compatible server)
# Used when AI_PROVIDER=local
# Ollama default: http://localhost:11434/v1  |  LM Studio: http://localhost:1234/v1
LOCAL_AI_BASE_URL=http://localhost:11434/v1
# Model name as registered in your local server (e.g. llama3.2, mistral, qwen2.5:7b)
LOCAL_AI_MODEL=llama3.2
# Most local servers don't require a real API key; use any non-empty string
LOCAL_AI_API_KEY=ollama

# Azure OpenAI (used when AI_PROVIDER=azure or AI_PROVIDER is unset)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-11-01-preview

# ─── Health Check & Production Configuration ────────────────────────────────
# Token required in the x-healthcheck-token header for /api/health/config.
# Production only; the endpoint is open outside production when empty.
HEALTHCHECK_TOKEN=

# ─── Billing & Payments ─────────────────────────────────────────────────────
# Billing is on by default; local development uses the mock payment adapter.
BILLING_ENABLED=true
# Development may use mock. Production requires a real provider and webhook
# secret when billing is enabled. Production only.
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=

# ─── Document Storage ───────────────────────────────────────────────────────
# Private CV bucket used when document storage is enabled. Production only.
DOCUMENT_STORAGE_ENABLED=true
SUPABASE_CV_BUCKET=

# ─── Email Delivery (Brevo) ─────────────────────────────────────────────────
# Default false: development uses the server-side mock delivery. Production
# requires Brevo with the variables below when this is enabled.
EMAIL_DELIVERY_ENABLED=false
EMAIL_PROVIDER=mock
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
